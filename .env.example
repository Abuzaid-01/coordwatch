# CoordWatch Environment Configuration

# Bluesky Jetstream WebSocket Endpoints
JETSTREAM_URL="wss://jetstream2.us-east.bsky.network/subscribe?wantedCollections=app.bsky.feed.post"
JETSTREAM_FALLBACK_URL="wss://jetstream1.us-east.bsky.network/subscribe?wantedCollections=app.bsky.feed.post"

# AT Protocol Identity Resolution
PLC_DIRECTORY_URL="https://plc.directory"
BSKY_PUBLIC_API_URL="https://public.api.bsky.app"

# Storage & Paths
DATA_DIR="data"
COORDWATCH_DB_PATH="data/coordwatch.db"
SAMPLE_JSONL_PATH="data/sample_posts.jsonl"
DEMO_SEED_JSONL_PATH="data/demo_seed.jsonl"

# Security & CORS
CORS_ORIGINS="*"
